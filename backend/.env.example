# Backend environment variables (copy to `.env`)

# Port of the Express API
PORT=3000

# SQLite database file. Use `:memory:` for throwaway databases.
DB_PATH=./data/panierfermier.db

# JWT signing secret. REQUIRED when NODE_ENV=production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

NODE_ENV=development
